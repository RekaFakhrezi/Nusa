{
    "version": 2,
    "framework": "laravel",
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.1",
            "includeFiles": "**"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/assets/(.*)",
            "dest": "/public/assets/$1"
        },
        {
            "src": "/favicon.(ico|png)",
            "dest": "/public/favicon.$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}